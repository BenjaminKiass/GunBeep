                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="&#xE962;" Style="{StaticResource Glyph}"/>
                                            <StackPanel>
                                                <TextBlock Text="ตัวขยับเมาส์ (Engine)" Style="{StaticResource CardTitle}"/>
