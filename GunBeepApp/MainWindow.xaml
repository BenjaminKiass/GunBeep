<Window x:Class="GunBeep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GunBeep" Width="960" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Leelawadee UI" UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B8E9A"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#5D606B"/>
        <SolidColorBrush x:Key="LineBrush" Color="#262933"/>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#262933"/>
            <Setter Property="BorderBrush" Value="#3A3E4C"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" MinWidth="70" Height="30" CornerRadius="8" Padding="12,0"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#30343F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#C9CBD3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Width="24" Height="24" CornerRadius="7" Background="#262933">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#353948"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="5" CornerRadius="2.5" Background="#2E313B" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6366F1" Offset="0"/>
                                        <GradientStop Color="#22D3EE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NiceSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.5"/>
            <Setter Property="SmallChange" Value="0.5"/>
            <Setter Property="LargeChange" Value="0.5"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackFill}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackEmpty}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#6366F1" Opacity="0.9"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="#2E313B">
                            <Ellipse x:Name="knob" Width="20" Height="20" Fill="#C9CBD3" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="tx" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#6366F1" Offset="0"/>
                                            <GradientStop Color="#22D3EE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="knob" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <!-- เงาใต้หน้าต่าง -->
        <Border CornerRadius="24" Background="#0B0C10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="24" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#3A3E4C" Offset="0"/>
                    <GradientStop Color="#1E2028" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                    <GradientStop Color="#1E212B" Offset="0"/>
                    <GradientStop Color="#121318" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel>
                <!-- แถบหัว (ลากเพื่อย้ายหน้าต่าง) -->
                <Grid Height="58" Background="Transparent" Margin="18,6,12,0" MouseLeftButtonDown="Title_Drag">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#22D3EE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#6366F1" Opacity="0.6"/>
                            </Border.Effect>
                            <TextBlock Text="&#xE1D2;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GunBeep" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="SubTitle" Text="Recoil Control Panel" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="UpdateBtn" Style="{StaticResource KeyBtn}" Visibility="Collapsed" Margin="0,0,10,0"
                                BorderBrush="#22C55E" Click="Update_Click" ToolTip="มีเวอร์ชันใหม่บน GitHub"/>
                        <Button Style="{StaticResource ChromeBtn}" Content="&#xE921;" Click="Min_Click" ToolTip="ซ่อนไปที่ถาดไอคอน"/>
                        <Button Style="{StaticResource ChromeBtn}" Content="&#xE8BB;" Click="Close_Click" ToolTip="ปิดโปรแกรม"/>
                    </StackPanel>
                </Grid>

                <!-- เนื้อหา 3 คอลัมน์ (แนวนอน) -->
                <Grid Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>

                    <!-- ซ้าย: ปุ่มเปิด/ปิด -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Grid x:Name="PowerBtn" Width="180" Height="180" Cursor="Hand" Background="Transparent"
                              RenderTransformOrigin="0.5,0.5"
                              MouseLeftButtonDown="Power_Down" MouseLeftButtonUp="Power_Up" MouseLeave="Power_Leave">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Glow" Margin="22" Opacity="0.3">
                                <Ellipse.Effect><BlurEffect Radius="42"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Margin="24">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.7,1">
                                        <GradientStop Color="#2C303C" Offset="0"/>
                                        <GradientStop Color="#14151B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="10" Direction="270" Opacity="0.7" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Ring" Margin="24" StrokeThickness="3"/>
                            <Ellipse Margin="33" StrokeThickness="1.2">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="38" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PowerText" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="StatusText" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="PowerHint" HorizontalAlignment="Center" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="EventText" HorizontalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#A5B4FC" Opacity="0" Margin="0,14,0,0" Text=" " TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="220"/>
                    </StackPanel>

                    <!-- กลาง: ชุดค่าปืน + ปรับค่า -->
                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <DockPanel Margin="6,6,6,8">
                            <TextBlock Text="ชุดค่าปืน" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="ในเกม: ปุ่ม Back (4) ตอนเปิดอยู่" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <UniformGrid x:Name="GunGrid" Columns="3" Margin="-5,0,-5,0"
                                     ToolTip="คลิก = เลือกปืนที่จะปรับค่า · ดับเบิลคลิก = เปลี่ยนชื่อ"/>

                        <Border Margin="0,10,0,0" CornerRadius="16" Background="#171920" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="16,10,16,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="TuneTitle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="ในเกม: Ctrl/Alt + Back" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="แรงดึงลง" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource StepBtn}" Content="&#xE738;" Tag="base-" Click="Step_Click"/>
                                    <Slider x:Name="BaseSlider" Grid.Column="2" Style="{StaticResource NiceSlider}" Minimum="0" Maximum="20" Margin="8,0"/>
                                    <Button Grid.Column="3" Style="{StaticResource StepBtn}" Content="&#xE710;" Tag="base+" Click="Step_Click"/>
                                    <TextBlock x:Name="BaseValue" Grid.Column="4" FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="#7DD3FC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ซ้าย / ขวา" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource StepBtn}" Content="&#xE738;" Tag="x-" Click="Step_Click"/>
                                    <Slider x:Name="XSlider" Grid.Column="2" Style="{StaticResource NiceSlider}" Minimum="-5" Maximum="5" Margin="8,0"/>
                                    <Button Grid.Column="3" Style="{StaticResource StepBtn}" Content="&#xE710;" Tag="x+" Click="Step_Click"/>
                                    <TextBlock x:Name="XValue" Grid.Column="4" FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="#7DD3FC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Button x:Name="ApplyBtn" Style="{StaticResource KeyBtn}" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                        Click="Apply_Click" ToolTip="ส่งค่าเข้า G Hub ทันที ไม่ต้องรีสตาร์ท (ปล่อยหลอดเลื่อนแล้วจะส่งให้เอง)"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ขวา: ตั้งค่า + G Hub -->
                    <StackPanel Grid.Column="2" Margin="0,6,0,0">
                        <Border CornerRadius="16" Background="#171920" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="16,4">
                            <StackPanel>
                                <DockPanel Height="46">
                                    <Button x:Name="HotkeyBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="Hotkey_Click" ToolTip="คลิกแล้วกดปุ่มที่ต้องการ"/>
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="ปุ่มลัดเปิด/ปิด" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="46">
                                    <ToggleButton x:Name="SoundSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="เสียงแจ้งเตือน" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="46">
                                    <ToggleButton x:Name="TopSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="ลอยอยู่บนเกม" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" CornerRadius="16" Background="#171920" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="16,12,16,12">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="SetupBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Content="ตรวจสอบ..." Click="Setup_Click"/>
                                    <TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="G Hub" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel x:Name="GHubRows" Margin="26,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Border Height="18"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
