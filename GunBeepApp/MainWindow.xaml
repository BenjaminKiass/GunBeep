<Window x:Class="GunBeep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="all@Ben-GunBeep" Width="960" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Leelawadee UI" UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8094BC"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#4E5D80"/>
        <SolidColorBrush x:Key="LineBrush" Color="#18223A"/>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#121B30"/>
            <Setter Property="BorderBrush" Value="#24345A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" MinWidth="70" Height="30" CornerRadius="8" Padding="12,0"
                                Background="#121B30" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" BlurRadius="12" ShadowDepth="0" Color="#1D6BFF" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1A2C52" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#121B30" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- เมนูคลิกขวา/ดรอปดาวน์ธีมมืด -->
        <Style TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#0B1222" BorderBrush="#24345A" BorderThickness="1" CornerRadius="10" Padding="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="12,7,16,7" MinWidth="200">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A2C52"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4E5D80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#18223A" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#C4D3F0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Width="24" Height="24" CornerRadius="7" Background="#121B30">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E2C4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="5" CornerRadius="2.5" Background="#1A2440" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1D6BFF" Offset="0"/>
                                        <GradientStop Color="#5CE1FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackClear" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- หลอดซ้าย/ขวา: ตัวหลอดไม่วาดเส้นเอง (วาดจากโค้ด เติมสีจากตรงกลาง 0 ไปทางซ้ายหรือขวา) -->
        <Style x:Key="CenterSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.5"/>
            <Setter Property="SmallChange" Value="0.5"/>
            <Setter Property="LargeChange" Value="0.5"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackClear}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackClear}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#1D6BFF" Opacity="0.9"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NiceSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.5"/>
            <Setter Property="SmallChange" Value="0.5"/>
            <Setter Property="LargeChange" Value="0.5"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackFill}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackEmpty}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#1D6BFF" Opacity="0.9"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F7BB4"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>

        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#8FA3C8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="10" Background="#111A2E" BorderBrush="#22304E" BorderThickness="1" Padding="8,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#172341"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#173A8C" Offset="0"/>
                                            <GradientStop Color="#1D5BD8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="b" Property="BorderBrush" Value="#4C8DFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="#1A2440">
                            <Ellipse x:Name="knob" Width="20" Height="20" Fill="#C4D3F0" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="tx" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1D6BFF" Offset="0"/>
                                            <GradientStop Color="#5CE1FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="knob" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="22" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"/>
                <TranslateTransform x:Name="RootShift"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <!-- เงาใต้หน้าต่าง -->
        <Border CornerRadius="24" Background="#05070D">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6" Color="Black"/>
            </Border.Effect>
        </Border>

        <!-- ขอบไฟฟ้าวิ่งรอบหน้าต่าง -->
        <Border CornerRadius="24" BorderThickness="1.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="EdgeSpin" CenterX="0.5" CenterY="0.5"/>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#5CE1FF" Offset="0"/>
                    <GradientStop Color="#1D6BFF" Offset="0.2"/>
                    <GradientStop Color="#141F3A" Offset="0.45"/>
                    <GradientStop Color="#141F3A" Offset="0.7"/>
                    <GradientStop Color="#C9A54A" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                    <GradientStop Color="#0E1528" Offset="0"/>
                    <GradientStop Color="#070A12" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel>
                <!-- แถบหัว (ลากเพื่อย้ายหน้าต่าง) -->
                <Grid Height="58" Background="Transparent" Margin="18,6,12,0" MouseLeftButtonDown="Title_Drag">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- โลโก้: logo.png (ข้าง GunBeep.exe หรือฝังในโปรแกรม) ถ้าไม่มีใช้มงกุฎแทน -->
                        <Grid Width="46" Height="46">
                            <Ellipse x:Name="LogoGlow" Margin="4" Fill="#1D6BFF" Opacity="0.45">
                                <Ellipse.Effect><BlurEffect Radius="16"/></Ellipse.Effect>
                            </Ellipse>
                            <Border x:Name="LogoFallback" Width="38" Height="38" CornerRadius="12" BorderThickness="1" BorderBrush="#5CE1FF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0B2A66" Offset="0"/>
                                        <GradientStop Color="#05070D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="♛" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFE7A0" Offset="0"/>
                                            <GradientStop Color="#E3A21A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>
                            <Image x:Name="LogoImg" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed">
                                <Image.Clip><EllipseGeometry Center="23,23" RadiusX="23" RadiusY="23"/></Image.Clip>
                            </Image>
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="all@Ben" FontSize="17" FontWeight="Black">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E6F7FF" Offset="0"/>
                                            <GradientStop Color="#5CE1FF" Offset="0.45"/>
                                            <GradientStop Color="#1D6BFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#1D6BFF" Opacity="0.85"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="-GunBeep" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="SubTitle" Text="Recoil Control Panel" FontSize="10.5" Foreground="#C9A54A" Margin="1,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="UpdateBtn" Style="{StaticResource KeyBtn}" Visibility="Collapsed" Margin="0,0,10,0"
                                BorderBrush="#22C55E" Click="Update_Click" ToolTip="มีเวอร์ชันใหม่บน GitHub"/>
                        <Button Style="{StaticResource ChromeBtn}" Content="&#xE921;" Click="Min_Click" ToolTip="ซ่อนไปที่ถาดไอคอน"/>
                        <Button Style="{StaticResource ChromeBtn}" Content="&#xE8BB;" Click="Close_Click" ToolTip="ปิดโปรแกรม"/>
                    </StackPanel>
                </Grid>

                <!-- เนื้อหา 3 คอลัมน์ (แนวนอน) -->
                <Grid Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>

                    <!-- ซ้าย: ปุ่มเปิด/ปิด -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Grid x:Name="PowerBtn" Width="180" Height="180" Cursor="Hand" Background="Transparent"
                              RenderTransformOrigin="0.5,0.5"
                              MouseLeftButtonDown="Power_Down" MouseLeftButtonUp="Power_Up" MouseLeave="Power_Leave">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Glow" Margin="22" Opacity="0.3">
                                <Ellipse.Effect><BlurEffect Radius="42"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Margin="24">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.7,1">
                                        <GradientStop Color="#16213A" Offset="0"/>
                                        <GradientStop Color="#080C16" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="10" Direction="270" Opacity="0.7" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Ring" Margin="24" StrokeThickness="3"/>
                            <Ellipse Margin="33" StrokeThickness="1.2">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="38" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PowerText" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="StatusText" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="PowerHint" HorizontalAlignment="Center" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="EventText" HorizontalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#9CC8FF" Opacity="0" Margin="0,14,0,0" Text=" " TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="220"/>
                    </StackPanel>

                    <!-- กลาง: ชุดค่าปืน + ปรับค่า -->
                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <DockPanel Margin="6,6,6,8">
                            <TextBlock Text="ชุดค่าสโคป" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <Button x:Name="CycleBtn" Style="{StaticResource KeyBtn}" FontSize="11" Padding="9,2" MinWidth="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cycle_Click"
                                    ToolTip="ปุ่มในเกม (ตอนเปิดมาโคร): กดเปล่า = วนปืน · Ctrl/Alt = base ±0.5 · Shift+Ctrl/Alt = ซ้าย/ขวา ±0.5"/>
                        </DockPanel>
                        <UniformGrid x:Name="GunGrid" Columns="3" Margin="-5,0,-5,0"
                                     ToolTip="คลิก = เลือกปืนที่จะปรับค่า · ดับเบิลคลิก = เปลี่ยนชื่อ"/>

                        <Border Margin="0,10,0,0" CornerRadius="16" Background="#0D1322" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="16,10,16,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="TuneTitle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="ในเกม: Ctrl/Alt + Back" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="แรงดึงลง" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource StepBtn}" Content="&#xE738;" Tag="base-" Click="Step_Click"/>
                                    <Slider x:Name="BaseSlider" Grid.Column="2" Style="{StaticResource NiceSlider}" Minimum="0" Maximum="50" Margin="8,0"/>
                                    <Button Grid.Column="3" Style="{StaticResource StepBtn}" Content="&#xE710;" Tag="base+" Click="Step_Click"/>
                                    <TextBlock x:Name="BaseValue" Grid.Column="4" FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="#8FDBFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ซ้าย / ขวา" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource StepBtn}" Content="&#xE738;" Tag="x-" Click="Step_Click"/>
                                    <Grid Grid.Column="2" Margin="8,0" SizeChanged="XBar_SizeChanged">
                                        <Border Height="5" CornerRadius="2.5" Background="#1A2440" Margin="8,0" VerticalAlignment="Center"/>
                                        <Border x:Name="XFill" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                                        <Border x:Name="XMid" Width="2" Height="11" CornerRadius="1" Background="#5A6C94"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Slider x:Name="XSlider" Style="{StaticResource CenterSlider}" Minimum="-5" Maximum="5"/>
                                    </Grid>
                                    <Button Grid.Column="3" Style="{StaticResource StepBtn}" Content="&#xE710;" Tag="x+" Click="Step_Click"/>
                                    <TextBlock x:Name="XValue" Grid.Column="4" FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="#8FDBFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <DockPanel Margin="0,12,0,0">
                                    <Button x:Name="CalibBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="8,0,0,0"
                                            Click="Calib_Click" ToolTip="อัดการลากเมาส์ของคุณตอนยิงจริง แล้วตั้ง base / x / กราฟให้อัตโนมัติ">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="อัดค่า" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ShotsBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="8,0,0,0"
                                            Click="Shots_Click" ToolTip="ตารางแรงดึงรายนัด: นัดที่ 1–42 ดึงลงเท่าไหร่ · ความเร็วยิง · จำนวนนัด · ปรับทีละช่วง">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="รายนัด" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SegsBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="8,0,0,0"
                                            Click="Segs_Click" ToolTip="แก้กราฟแรงดีดตามเวลา (ตาราง segs) ของแต่ละปืน">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="กราฟ" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ApplyBtn" Style="{StaticResource KeyBtn}" HorizontalAlignment="Stretch"
                                            Click="Apply_Click" ToolTip="ส่งค่าเข้า G Hub ทันที ไม่ต้องรีสตาร์ท (ปล่อยหลอดเลื่อนแล้วจะส่งให้เอง)"/>
                                </DockPanel>
                                <Button x:Name="EyeBtn" Style="{StaticResource KeyBtn}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                        BorderBrush="#C9A54A" Click="Eye_Click" Visibility="Collapsed"
                                        ToolTip="ยิงใส่กำแพง มือนิ่ง ดูรอยกระสุน แล้วตอบด้วยปุ่มลูกศร — ป้ายบนจอบอกทุกขั้น"/>
                                <Button x:Name="VisionBtn" Style="{StaticResource KeyBtn}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                        BorderBrush="#1D6BFF" Click="Vision_Click" Visibility="Collapsed"
                                        ToolTip="สแกนหน้ากระเป๋า (Tab) ตรวจจับปืน ของแต่ง ลำกล้อง และคำนวณแรงดีดออโต้">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#5CE1FF"/>
                                        <TextBlock Text="AI Detect ปืน · ของแต่ง · ลำกล้อง (Tab)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- การยิง: โหมดดึง + หยุดหลังยิงครบ -->
                        <Border Margin="0,10,0,0" CornerRadius="16" Background="#0D1322" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="16,10,16,12">
                            <StackPanel>
                                <TextBlock Text="การยิง" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <Grid Margin="0,10,0,0" ToolTip="ยิงทุกครั้ง = ดึงทั้งยิงสะโพกและเล็ง · คลิกขวาค้าง = ดึงเฉพาะตอนกดคลิกขวาค้างไว้ (เล็ง ADS)">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ดึงตอน" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="AdsAllRb" Grid.Column="1" GroupName="ads" Style="{StaticResource SegRadio}" Checked="AdsRb_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="ยิงทุกครั้ง" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="AdsHoldRb" Grid.Column="2" GroupName="ads" Style="{StaticResource SegRadio}" Margin="6,0,0,0" Checked="AdsRb_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="คลิกขวาค้าง" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>
                                <Grid Margin="0,10,0,0" ToolTip="นับกระสุน = นับจากเวลากดยิง แยกตามช่องปืน ครบแล้วหยุดดึงจนกว่าจะกด R · ไม่หยุด = ดึงตลอด (เทรนนิ่ง กระสุนไม่จำกัด)">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="แม็กหมด" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="MagOnRb" Grid.Column="1" GroupName="mag" Style="{StaticResource SegRadio}" Margin="5,0,0,0" Checked="MagRb_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="นับกระสุน" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="MagOffRb" Grid.Column="2" GroupName="mag" Style="{StaticResource SegRadio}" Margin="5,0,0,0" Checked="MagRb_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="ไม่หยุด (เทรนนิ่ง)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>
                                <Grid x:Name="ShotsRow" Margin="0,10,0,0" ToolTip="โหมดเสียงปืน: ตัวกันพลาด — ยิงค้างชุดเดียวเกินจำนวนนี้ = หยุดดึง (เช่น เพื่อนยิงข้างๆ จนไม่รู้ว่าแม็กเราหมด) · โหมดนับเวลา: นับแยกตามช่องปืน ครบแล้วหยุดจนกว่าจะกด R · แม็ก 40 ตั้ง 42, แม็ก 30 ตั้ง 32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="กระสุน/แม็ก" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource StepBtn}" Content="&#xE738;" Tag="-" Click="ShotsStep_Click"/>
                                    <Slider x:Name="ShotsSlider" Grid.Column="2" Style="{StaticResource NiceSlider}" Minimum="5" Maximum="120"
                                            IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5" Margin="8,0"/>
                                    <Button Grid.Column="3" Style="{StaticResource StepBtn}" Content="&#xE710;" Tag="+" Click="ShotsStep_Click"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBox x:Name="ShotsBox" Width="34" Text="42" FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                                 Foreground="#8FDBFF" Background="#121B30" BorderBrush="#2A3A5C" BorderThickness="1"
                                                 CaretBrush="#8FDBFF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 MaxLength="3" Padding="0,2" ToolTip="พิมพ์จำนวนนัด (5–120) แล้วกด Enter"/>
                                        <TextBlock Text=" นัด" Foreground="#8FDBFF" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- โปรไฟล์ค่าปืน: เก็บหลายชุด / ส่งออก / นำเข้า -->
                        <Border Margin="0,10,0,0" CornerRadius="16" Background="#0D1322" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="16,10,12,10">
                            <DockPanel>
                                <Button x:Name="PresetMoreBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="8,0,0,0"
                                        Content="นำเข้า / ส่งออก" Click="PresetMore_Click" ToolTip="นำเข้าจากไฟล์ · ส่งออกเป็นไฟล์ · ลบ · เปิดโฟลเดอร์"/>
                                <Button x:Name="PresetSaveBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="8,0,0,0"
                                        Content="บันทึก" Click="PresetSave_Click" ToolTip="บันทึกค่าปืนทั้ง 3 ชุดตอนนี้เป็นโปรไฟล์"/>
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Width="24"/>
                                <Button x:Name="PresetBtn" Style="{StaticResource KeyBtn}" HorizontalContentAlignment="Left"
                                        Click="Preset_Click" ToolTip="เลือกโปรไฟล์ค่าปืนที่บันทึกไว้"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ขวา: ตั้งค่า + G Hub -->
                    <StackPanel Grid.Column="2" Margin="0,6,0,0">
                        <Border CornerRadius="16" Background="#0D1322" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="16,0,16,6">
                            <StackPanel>
                                <TextBlock Text="ทั่วไป" Style="{StaticResource SectionTitle}"/>
                                <DockPanel Height="40">
                                    <Button x:Name="HotkeyBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="Hotkey_Click" ToolTip="คลิกแล้วกดปุ่มที่ต้องการ (ปุ่มเมาส์กลาง/Back/Forward ก็ได้)"/>
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="ปุ่มลัดเปิด/ปิด" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40" ToolTip="กดในเกมเพื่อวนโปรไฟล์ค่าปืนที่บันทึกไว้ (ส่งค่าเข้า G Hub ทันที)">
                                    <Button x:Name="PresetKeyBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="PresetKey_Click"/>
                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="ปุ่มสลับโปรไฟล์" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40">
                                    <ToggleButton x:Name="SoundSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="เสียงแจ้งเตือน" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40" ToolTip="เปิด GunBeep เองตอนเข้า Windows (ย่ออยู่ที่ถาด มาโครปิดไว้ก่อน)">
                                    <ToggleButton x:Name="AutoStartSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="เปิดพร้อม Windows" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" CornerRadius="16" Background="#0D1322" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="16,0,16,6">
                            <StackPanel>
                                <TextBlock Text="ในเกม" Style="{StaticResource SectionTitle}"/>
                                <DockPanel Height="40" ToolTip="เข้าเกม PUBG = สลับคีย์บอร์ดเป็นภาษาอังกฤษให้เอง (ภาษาไทยแล้วกดเปลี่ยนปืน/ปุ่มอื่นในเกมไม่ได้) · ออกจากเกม = คืนภาษาเดิม">
                                    <ToggleButton x:Name="LangSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Lang_Click"/>
                                    <TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="ภาษาอังกฤษอัตโนมัติ" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40" ToolTip="ตั้งปุ่มเลือกชุดค่า 1 / 2 / 3 ตรงๆ (เช่น ชุด 4x, Red/Holo, 6x) — กดในเกมตอนเปลี่ยนสโคปแล้วใช้ค่าชุดนั้นทันที · คลิกแล้วกดปุ่ม (Del = ไม่ใช้)">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="Scope1Btn" Style="{StaticResource KeyBtn}" MinWidth="0" Padding="8,3" FontSize="11.5"
                                                Margin="0,0,0,0" Tag="1" Click="ScopeKey_Click"/>
                                        <Button x:Name="Scope2Btn" Style="{StaticResource KeyBtn}" MinWidth="0" Padding="8,3" FontSize="11.5"
                                                Margin="5,0,0,0" Tag="2" Click="ScopeKey_Click"/>
                                        <Button x:Name="Scope3Btn" Style="{StaticResource KeyBtn}" MinWidth="0" Padding="8,3" FontSize="11.5"
                                                Margin="5,0,0,0" Tag="3" Click="ScopeKey_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="ปุ่มเลือกสโคป" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40" ToolTip="คำนวณแรงดีด: ตารางในการ์ด × ปืน × สโคป × ของแต่ง × ย่อ/หมอบ — G Hub ขยับเมาส์เหมือนเดิม GunBeep ส่งตัวคูณให้ · ⚙ = ปรับ %">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="5,0,0,0" Padding="7,3"
                                            VerticalAlignment="Center" Click="CalcSetup_Click" ToolTip="ปรับ % ของแต่ง ท่าทาง และตัวคูณแต่ละปืน">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <Button x:Name="CalcBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="Calc_Click"/>
                                    <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="คำนวณแรงดีด" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40" ToolTip="ตรวจสโคปอัตโนมัติ: เปิดกระเป๋าแล้ว GunBeep ดูว่าปืนแต่ละช่องติดสโคปอะไร → เปลี่ยนปืนแล้วใช้ชุดค่าตามสโคปเอง — คลิกเพื่อตั้งค่าและสอนสโคป">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="5,0,0,0" Padding="7,3"
                                            VerticalAlignment="Center" Click="ScopeSetup_Click" ToolTip="ดู/แก้ตำแหน่งและสโคปที่จำไว้ (ปกติไม่ต้องใช้)">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <Button x:Name="ScopeAutoBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="ScopeAuto_Click"/>
                                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="ตรวจสโคปอัตโนมัติ" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40" ToolTip="ในเกมกด 1 = ปืน 1, กด 2 = ปืน 2 (ช่องปืนหลัก/รอง) · ลูกกลิ้ง = สลับไปอีกช่อง — ทำงานตอนเปิดมาโคร">
                                    <Button x:Name="SlotBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="Slot_Click"/>
                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="สลับปืนตามช่อง" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40" ToolTip="SOCD: กดปุ่มทิศตรงข้ามพร้อมกัน (เช่น A กับ D) ให้ปุ่มล่าสุดชนะ แบบคีย์บอร์ด Snap Tap — คลิกเพื่อตั้งค่า">
                                    <Button x:Name="SocdBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="Socd_Click"/>
                                    <TextBlock Text="&#xE759;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="SOCD (ปุ่มทิศชนกัน)" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40" ToolTip="เก็บของเร็ว: เปิดกระเป๋าแล้วกดปุ่มเดียว ลากของบนพื้นเข้ากระเป๋าให้ทีละช่อง — คลิกเพื่อตั้งปุ่มและตำแหน่ง">
                                    <Button x:Name="LootBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="Loot_Click"/>
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="เก็บของเร็ว" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" CornerRadius="16" Background="#0D1322" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="16,0,16,6">
                            <StackPanel>
                                <TextBlock Text="หน้าจอ" Style="{StaticResource SectionTitle}"/>
                                <DockPanel Height="40" ToolTip="ป้ายเล็กๆ บนมุมจอ บอกเปิด/ปิด + ปืน (เกมต้องเป็นโหมด Borderless หรือ Windowed)">
                                    <Button x:Name="OsdModeBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="OsdMode_Click"/>
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="ป้ายบนจอเกม" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40">
                                    <Button x:Name="OsdCornerBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="OsdCorner_Click"/>
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="ตำแหน่งป้าย" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40" ToolTip="จอยืดแบบ Borderless: เปลี่ยนความละเอียด Windows ให้ตอนเปิด PUBG หรือตลอดตั้งแต่เปิด GunBeep — ปิดเกม/ปิด GunBeep แล้วคืนค่าเดิม">
                                    <Button x:Name="ResBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Click="Res_Click"/>
                                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="จอยืด" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <DockPanel Height="40">
                                    <ToggleButton x:Name="TopSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="หน้าต่างนี้ลอยบนเกม" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" CornerRadius="16" Background="#0D1322" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="16,12,16,12">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="SetupBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                            VerticalAlignment="Center" Content="ตรวจสอบ..." Click="Setup_Click"/>
                                    <TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Width="26"/>
                                    <TextBlock Text="G Hub" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel x:Name="GHubRows" Margin="26,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Border Height="18"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
