                                                    <TextBlock Text="Logitech G Hub (สำรอง)" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ตั้งค่าเกม PUBG (อ่านเองจากไฟล์ตั้งค่าเกม) -->
