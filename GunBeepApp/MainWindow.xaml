                                                    Click="LootKey_Click" ToolTip="คลิกแล้วกดปุ่มคีย์บอร์ด หรือปุ่มเมาส์ (กลาง / Back / Forward)"/>
                                            <ToggleButton x:Name="LootSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="LootSwitch_Click"/>
                                            <StackPanel>
                                                <TextBlock Text="เปิดใช้เก็บของเร็ว" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="กดปุ่มที่ตั้งไว้ตอนเปิดกระเป๋า = ลากของให้ · กดซ้ำระหว่างเก็บ = หยุด" Style="{StaticResource CardSub}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,14">
                                                <TextBlock Text="&#xE8B0;" Style="{StaticResource Glyph}"/>
                                                <StackPanel>
                                                    <TextBlock Text="รอบการเก็บ" Style="{StaticResource CardTitle}"/>
                                                    <TextBlock Text="จำนวนช่องและความเร็ว" Style="{StaticResource CardSub}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource StepBtn}" Content="&#xE738;" Tag="-" Click="LootSlots_Click"/>
                                                    <TextBlock x:Name="LootSlotsText" Text="8" Width="36" TextAlignment="Center" FontSize="14" FontWeight="Bold"
                                                               FontFamily="Consolas" Foreground="#8FDBFF" VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource StepBtn}" Content="&#xE710;" Tag="+" Click="LootSlots_Click"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="ช่องบนพื้นต่อรอบ" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="ลากจากช่องล่างขึ้นบน" Style="{StaticResource CardSub}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ความเร็ว" FontSize="12.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
