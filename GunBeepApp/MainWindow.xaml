                                                    <TextBlock Text="ป้ายบนจอเกม" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                                <DockPanel Height="40">
                                                    <Button x:Name="OsdCornerBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                                            VerticalAlignment="Center" Click="OsdCorner_Click"/>
                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="ตำแหน่งป้าย" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                                <DockPanel Height="40" ToolTip="จอยืดแบบ Borderless: เปลี่ยนความละเอียด Windows ให้ตอนเปิด PUBG หรือตลอดตั้งแต่เปิด GunBeep — ปิดเกม/ปิด GunBeep แล้วคืนค่าเดิม">
                                                    <Button x:Name="ResBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                                            VerticalAlignment="Center" Click="Res_Click"/>
                                                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="จอยืด" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                                <DockPanel Height="40">
                                                    <ToggleButton x:Name="TopSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="หน้าต่างนี้ลอยบนเกม" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource Card}" Padding="16,0,16,6">
                                            <StackPanel>
                                                <TextBlock Text="ในเกม" Style="{StaticResource SectionTitle}"/>
                                                <DockPanel Height="40" ToolTip="เข้าเกม PUBG = สลับคีย์บอร์ดเป็นภาษาอังกฤษให้เอง (ภาษาไทยแล้วกดเปลี่ยนปืน/ปุ่มอื่นในเกมไม่ได้) · ออกจากเกม = คืนภาษาเดิม">
                                                    <ToggleButton x:Name="LangSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Lang_Click"/>
                                                    <TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="ภาษาอังกฤษอัตโนมัติ" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                                <DockPanel Height="40" ToolTip="ถือระเบิด / มีด / เก็บปืน (ปุ่ม 4 · 5 · X) = ไม่ดึง จนกว่าจะเปลี่ยนกลับไปถือปืน (ปุ่มปืน หรือลูกกลิ้ง)">
                                                    <ToggleButton x:Name="HolsterSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Holster_Click"/>
                                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="ไม่ดึงตอนถือระเบิด/มีด" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                                <DockPanel Height="40" ToolTip="ตั้งปุ่มเลือกชุดค่า 1 / 2 / 3 ตรงๆ (เช่น ชุด 4x, Red/Holo, 6x) — กดในเกมตอนเปลี่ยนสโคปแล้วใช้ค่าชุดนั้นทันที · คลิกแล้วกดปุ่ม (Del = ไม่ใช้)">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button x:Name="Scope1Btn" Style="{StaticResource KeyBtn}" MinWidth="0" Padding="8,3" FontSize="11.5"
                                                                Margin="0,0,0,0" Tag="1" Click="ScopeKey_Click"/>
                                                        <Button x:Name="Scope2Btn" Style="{StaticResource KeyBtn}" MinWidth="0" Padding="8,3" FontSize="11.5"
                                                                Margin="5,0,0,0" Tag="2" Click="ScopeKey_Click"/>
                                                        <Button x:Name="Scope3Btn" Style="{StaticResource KeyBtn}" MinWidth="0" Padding="8,3" FontSize="11.5"
                                                                Margin="5,0,0,0" Tag="3" Click="ScopeKey_Click"/>
                                                    </StackPanel>
                                                    <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="ปุ่มเลือกสโคป" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                                <DockPanel Height="40" ToolTip="ตรวจสโคปอัตโนมัติ: เปิดกระเป๋าแล้ว GunBeep ดูว่าปืนแต่ละช่องติดสโคปอะไร → เปลี่ยนปืนแล้วใช้ชุดค่าตามสโคปเอง">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="5,0,0,0" Padding="7,3" MinWidth="0"
                                                            VerticalAlignment="Center" Click="ScopeSetup_Click" ToolTip="ดู/แก้ตำแหน่งและสโคปที่จำไว้ (ปกติไม่ต้องใช้)">
                                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                    </Button>
                                                    <Button x:Name="ScopeAutoBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                                            VerticalAlignment="Center" Click="ScopeAuto_Click"/>
                                                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="ตรวจสโคปอัตโนมัติ" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                                <DockPanel Height="40" ToolTip="ในเกมกด 1 = ปืน 1, กด 2 = ปืน 2 (ช่องปืนหลัก/รอง) · ลูกกลิ้ง = สลับไปอีกช่อง — ใช้ตอนปิดตรวจสโคปอัตโนมัติ">
                                                    <Button x:Name="SlotBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                                            VerticalAlignment="Center" Click="Slot_Click"/>
                                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="สลับปืนตามช่อง" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                                <DockPanel Height="40" ToolTip="SOCD: กดปุ่มทิศตรงข้ามพร้อมกัน (เช่น A กับ D) ให้ปุ่มล่าสุดชนะ แบบคีย์บอร์ด Snap Tap — คลิกเพื่อตั้งค่า">
                                                    <Button x:Name="SocdBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                                            VerticalAlignment="Center" Click="Socd_Click"/>
                                                    <TextBlock Text="&#xE759;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="SOCD (ปุ่มทิศชนกัน)" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="GHubCard" Style="{StaticResource Card}" Padding="16,12,16,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button x:Name="SetupBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}"
                                                            VerticalAlignment="Center" Content="ตรวจสอบ..." Click="Setup_Click"/>
                                                    <TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="G Hub" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <StackPanel x:Name="GHubRows" Margin="26,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
