                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Content="ตั้งเป็นค่าตอนจูน" FontSize="11.5" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" Click="GameRef_Click" ToolTip="กดเฉพาะตอนเพิ่งจูนตารางแรงดีดใหม่ด้วยความไวตอนนี้"/>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Content="↻  อ่านใหม่จากเกม" FontSize="11.5"
                                                    VerticalAlignment="Center" Click="GameReload_Click"/>
                                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}"/>
                                            <StackPanel>
                                                <TextBlock Text="ตั้งค่าเกม PUBG (อ่านเอง)" Style="{StaticResource CardTitle}"/>
                                                <TextBlock Text="อ่านจากไฟล์ตั้งค่าเกม (อ่านอย่างเดียว) — เปลี่ยนความไวในเกมแล้วแรงดึงปรับตามเอง ไม่ต้องจูนใหม่" Style="{StaticResource CardSub}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel x:Name="GameRows" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource Card}" Padding="16,0,16,6">
                                            <StackPanel>
                                                <TextBlock Text="ทั่วไป" Style="{StaticResource SectionTitle}"/>
                                                <DockPanel Height="40" ToolTip="เปิด PUBG = มาโครเปิดเอง · ปิดเกม = ปิดเอง (ปุ่มลัดยังกดเปิด/ปิดเองได้)">
