                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Text="&#xE81D;" Style="{StaticResource Glyph}"/>
                                                <StackPanel>
                                                    <TextBlock Text="ตำแหน่งที่ตั้งไว้" Style="{StaticResource CardTitle}"/>
                                                    <TextBlock x:Name="LootPosText" Text="" Style="{StaticResource CardSub}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="ตั้งจากภาพหน้ากระเป๋าในเกม (PrintScreen) ครั้งเดียวต่อความละเอียดจอ — ลากจุด ① ช่องแรก ② ช่องที่สอง กระเป๋า กลางจอ"
                                                       Style="{StaticResource CardSub}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
