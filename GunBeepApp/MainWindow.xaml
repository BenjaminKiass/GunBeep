                                                    <TextBlock Text="เสียงแจ้งเตือน" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{StaticResource LineBrush}"/>
