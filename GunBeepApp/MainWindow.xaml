<Window x:Class="GunBeep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="all@Ben-GunBeep" Width="1210" Height="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Leelawadee UI" UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8094BC"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#4E5D80"/>
        <SolidColorBrush x:Key="LineBrush" Color="#18223A"/>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#121B30"/>
            <Setter Property="BorderBrush" Value="#24345A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" MinWidth="70" Height="30" CornerRadius="8" Padding="12,0"
                                Background="#121B30" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" BlurRadius="12" ShadowDepth="0" Color="#1D6BFF" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1A2C52" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#121B30" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- เมนูคลิกขวา/ดรอปดาวน์ธีมมืด -->
        <Style TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#0B1222" BorderBrush="#24345A" BorderThickness="1" CornerRadius="10" Padding="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="12,7,16,7" MinWidth="200">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A2C52"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4E5D80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#18223A" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#C4D3F0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Width="24" Height="24" CornerRadius="7" Background="#121B30">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E2C4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="5" CornerRadius="2.5" Background="#1A2440" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1D6BFF" Offset="0"/>
                                        <GradientStop Color="#5CE1FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackClear" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- หลอดซ้าย/ขวา: ตัวหลอดไม่วาดเส้นเอง (วาดจากโค้ด เติมสีจากตรงกลาง 0 ไปทางซ้ายหรือขวา) -->
        <Style x:Key="CenterSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.5"/>
            <Setter Property="SmallChange" Value="0.5"/>
            <Setter Property="LargeChange" Value="0.5"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackClear}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackClear}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#1D6BFF" Opacity="0.9"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NiceSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.5"/>
            <Setter Property="SmallChange" Value="0.5"/>
            <Setter Property="LargeChange" Value="0.5"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackFill}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackEmpty}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#1D6BFF" Opacity="0.9"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F7BB4"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>

        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#8FA3C8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="10" Background="#111A2E" BorderBrush="#22304E" BorderThickness="1" Padding="8,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#172341"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#173A8C" Offset="0"/>
                                            <GradientStop Color="#1D5BD8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="b" Property="BorderBrush" Value="#4C8DFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="#1A2440">
                            <Ellipse x:Name="knob" Width="20" Height="20" Fill="#C4D3F0" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="tx" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1D6BFF" Offset="0"/>
                                            <GradientStop Color="#5CE1FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="knob" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- เมนูซ้าย (แบบแท็บ) -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#8FA3C8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#111A2E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1D6BFF" Offset="0"/>
                                            <GradientStop Color="#1A4FC4" Offset="0.55"/>
                                            <GradientStop Color="#2FB6E8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="b" Property="BorderBrush" Value="#5CE1FF"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#1D6BFF" Opacity="0.75"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- แถบเลื่อนบางๆ ธีมมืด -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#24345A"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#0D1322"/>
            <Setter Property="BorderBrush" Value="#18223A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EAF2FF"/>
        </Style>

        <Style x:Key="CardSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#5F7BB4"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#5CE1FF"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,14,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="22" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"/>
                <TranslateTransform x:Name="RootShift"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <!-- เงาใต้หน้าต่าง -->
        <Border CornerRadius="24" Background="#05070D">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6" Color="Black"/>
            </Border.Effect>
        </Border>

        <!-- ขอบไฟฟ้าวิ่งรอบหน้าต่าง -->
        <Border CornerRadius="24" BorderThickness="1.5" ClipToBounds="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="EdgeSpin" CenterX="0.5" CenterY="0.5"/>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#5CE1FF" Offset="0"/>
                    <GradientStop Color="#1D6BFF" Offset="0.2"/>
                    <GradientStop Color="#141F3A" Offset="0.45"/>
                    <GradientStop Color="#141F3A" Offset="0.7"/>
                    <GradientStop Color="#C9A54A" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                    <GradientStop Color="#0E1528" Offset="0"/>
                    <GradientStop Color="#070A12" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- แถบหัว (ลากเพื่อย้ายหน้าต่าง) -->
                <Grid Background="Transparent" Margin="18,6,12,0" MouseLeftButtonDown="Title_Drag">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- โลโก้: logo.png (ข้าง GunBeep.exe หรือฝังในโปรแกรม) ถ้าไม่มีใช้มงกุฎแทน -->
                        <Grid Width="46" Height="46">
                            <Ellipse x:Name="LogoGlow" Margin="4" Fill="#1D6BFF" Opacity="0.45">
                                <Ellipse.Effect><BlurEffect Radius="16"/></Ellipse.Effect>
                            </Ellipse>
                            <Border x:Name="LogoFallback" Width="38" Height="38" CornerRadius="12" BorderThickness="1" BorderBrush="#5CE1FF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0B2A66" Offset="0"/>
                                        <GradientStop Color="#05070D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="♛" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFE7A0" Offset="0"/>
                                            <GradientStop Color="#E3A21A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>
                            <Image x:Name="LogoImg" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed">
                                <Image.Clip><EllipseGeometry Center="23,23" RadiusX="23" RadiusY="23"/></Image.Clip>
                            </Image>
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="all@Ben" FontSize="17" FontWeight="Black">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E6F7FF" Offset="0"/>
                                            <GradientStop Color="#5CE1FF" Offset="0.45"/>
                                            <GradientStop Color="#1D6BFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#1D6BFF" Opacity="0.85"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="-GunBeep" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <Border Margin="12,2,0,0" CornerRadius="8" Padding="8,2" Background="#0F2147" BorderBrush="#1D6BFF" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="EngineBadge" Text="ENGINE ในตัว" FontSize="10" FontWeight="Bold" Foreground="#8FDBFF"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SubTitle" Text="Recoil Control Panel" FontSize="10.5" Foreground="#C9A54A" Margin="1,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="UpdateBtn" Style="{StaticResource KeyBtn}" Visibility="Collapsed" Margin="0,0,10,0"
                                BorderBrush="#22C55E" Click="Update_Click" ToolTip="มีเวอร์ชันใหม่บน GitHub"/>
                        <Button Style="{StaticResource ChromeBtn}" Content="&#xE921;" Click="Min_Click" ToolTip="ซ่อนไปที่ถาดไอคอน"/>
                        <Button Style="{StaticResource ChromeBtn}" Content="&#xE8BB;" Click="Close_Click" ToolTip="ปิดโปรแกรม"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===================== เมนูซ้าย ===================== -->
                    <Border Grid.Column="0" BorderThickness="0,0,2,0" Margin="0,4,0,0" CornerRadius="0,0,0,22" Background="#080D19">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1D6BFF" Offset="0"/>
                                <GradientStop Color="#5CE1FF" Offset="0.5"/>
                                <GradientStop Color="#C9A54A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <DockPanel Margin="14,10,14,14">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="MENU" FontSize="10" FontWeight="Bold" Foreground="#4E5D80" Margin="6,0,0,8"/>
                                <RadioButton x:Name="NavMacro" GroupName="nav" Style="{StaticResource NavRadio}" Tag="0" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" Margin="2,0,14,0"/>
                                        <StackPanel>
                                            <TextBlock Text="มาโคร" FontSize="13.5" FontWeight="Bold"/>
                                            <TextBlock Text="ปืน · สโคป · ของแต่ง (สด)" FontSize="10.5" Opacity="0.75"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavLoot" GroupName="nav" Style="{StaticResource NavRadio}" Tag="2" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" Margin="2,0,14,0"/>
                                        <StackPanel>
                                            <TextBlock Text="เก็บของเร็ว" FontSize="13.5" FontWeight="Bold"/>
                                            <TextBlock Text="Auto-pickup" FontSize="10.5" Opacity="0.75"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource NavRadio}" Tag="3" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" Margin="2,0,14,0"/>
                                        <StackPanel>
                                            <TextBlock Text="ตั้งค่า" FontSize="13.5" FontWeight="Bold"/>
                                            <TextBlock Text="มาโคร · เกม · จอ · เครื่องยนต์" FontSize="10.5" Opacity="0.75"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavTune" GroupName="nav" Style="{StaticResource NavRadio}" Tag="1" Checked="Nav_Checked" Opacity="0.7" Margin="0,14,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="2,0,14,0"/>
                                        <StackPanel>
                                            <TextBlock Text="ตารางต้นแบบ" FontSize="12.5" FontWeight="Bold"/>
                                            <TextBlock Text="ขั้นสูง · ปกติไม่ต้องแตะ" FontSize="10.5" Opacity="0.75"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- ล่าง: สถานะ -->
                            <StackPanel DockPanel.Dock="Bottom">
                                <Border CornerRadius="12" Background="#0D1322" BorderBrush="#18223A" BorderThickness="1" Padding="12,9" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border x:Name="GamePill" DockPanel.Dock="Right" CornerRadius="7" Padding="7,2" Background="#2A1416">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="GameDot" Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock x:Name="GameText" Text="TSLGAME OFF" FontSize="9.5" FontWeight="Bold" Foreground="#FCA5A5"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="ResText" Text="1920x1080" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8"/>
                                        <DockPanel>
                                            <TextBlock x:Name="HeldSlotText" DockPanel.Dock="Right" Text="ช่อง 1" FontSize="10.5" FontWeight="Bold" Foreground="#5F7BB4" VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE7C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#5CE1FF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="HeldText" Text="ยังไม่ถือปืน" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- กลาง: ปุ่มเปิด/ปิด -->
                            <StackPanel VerticalAlignment="Center">
                                <Grid x:Name="PowerBtn" Width="150" Height="150" Cursor="Hand" Background="Transparent"
                                      RenderTransformOrigin="0.5,0.5"
                                      MouseLeftButtonDown="Power_Down" MouseLeftButtonUp="Power_Up" MouseLeave="Power_Leave">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <Ellipse x:Name="Glow" Margin="18" Opacity="0.3">
                                        <Ellipse.Effect><BlurEffect Radius="36"/></Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse Margin="20">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.7,1">
                                                <GradientStop Color="#16213A" Offset="0"/>
                                                <GradientStop Color="#080C16" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="8" Direction="270" Opacity="0.7" Color="Black"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="Ring" Margin="20" StrokeThickness="3"/>
                                    <Ellipse Margin="28" StrokeThickness="1.2">
                                        <Ellipse.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#33FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Stroke>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="PowerText" FontSize="14" FontWeight="Bold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="PowerHint" HorizontalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="EventText" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#9CC8FF" Opacity="0" Margin="0,10,0,0" Text=" " TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="200"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ===================== หน้า ===================== -->
                    <Grid Grid.Column="1" Margin="0,4,0,0">

                        <!-- ===== หน้า 0: มาโคร (สด) ===== -->
                        <ScrollViewer x:Name="PageMacro" VerticalScrollBarVisibility="Auto" Padding="22,10,18,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Border x:Name="LivePill" DockPanel.Dock="Right" CornerRadius="10" Padding="10,4" Background="#2A1416" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="LiveText" Text="มาโครปิด" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="ปืนที่ถืออยู่" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="MacroSub" Text="เปิดกระเป๋า (Tab) ในเกม — GunBeep ดูปืน สโคป ของแต่ง แล้วคำนวณแรงดึงให้เอง" Style="{StaticResource CardSub}"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- ยังไม่เจอปืน -->
                                <Border x:Name="HeroPanel" Style="{StaticResource Card}" Padding="20,26">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid Width="104" Height="104" HorizontalAlignment="Center">
                                            <Ellipse Stroke="#24345A" StrokeThickness="1.5" StrokeDashArray="2 3"/>
                                            <Ellipse Margin="12">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#1A2C52" Offset="0"/>
                                                        <GradientStop Color="#0A1224" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#1D6BFF" Opacity="0.6"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#5CE1FF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="HeroTitle" Text="รอตรวจจับ" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="กด " FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            <Border CornerRadius="6" Background="#1D6BFF" Padding="8,1">
                                                <TextBlock Text="TAB" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock x:Name="HeroHint" Text=" ในเกมเพื่อดูปืน" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HeroRes" Text="1920x1080" FontSize="13" FontWeight="Bold" Foreground="#8FDBFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="HeroSet" Text="" FontSize="11.5" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- ปืน 2 ช่อง (สร้างในโค้ด) -->
                                <Grid x:Name="SlotGrid" Visibility="Collapsed" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SlotHost1" Grid.Column="0"/>
                                    <Border x:Name="SlotHost2" Grid.Column="2"/>
                                </Grid>

                                <!-- ปุ่มลัดแรงดีด -->
                                <Border Style="{StaticResource Card}" Margin="0,2,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Content="↻  อ่านปุ่มจากเกม" FontSize="11.5"
                                                    VerticalAlignment="Center" Click="RefreshKeys_Click" ToolTip="อ่านปุ่มเลือกปืน / ย่อ / หมอบ จากไฟล์ตั้งค่า PUBG ใหม่"/>
                                            <TextBlock Text="&#xE765;" Style="{StaticResource Glyph}"/>
                                            <StackPanel>
                                                <TextBlock Text="ปุ่มลัดแรงดีด" Style="{StaticResource CardTitle}"/>
                                                <TextBlock Text="ปุ่มในเกม PUBG (อ่านจากไฟล์ตั้งค่าเกม) — เปลี่ยนในเกมแล้วกดอ่านใหม่" Style="{StaticResource CardSub}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <UniformGrid x:Name="KeyCards" Columns="3"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== หน้า 1: จูนแรงดีด ===== -->
                        <ScrollViewer x:Name="PageTune" VerticalScrollBarVisibility="Auto" Padding="22,10,18,16" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="ตารางต้นแบบ (ขั้นสูง)" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="ไม่ต้องจูน — ทุกปืน ทุกสโคป ทุกของแต่ง ย่อ/หมอบ และความไวในเกม คำนวณจากตารางนี้ให้เองตอนกด Tab · ตารางนี้คือ AUG + เบรกปากกระบอก + กริปหัวแม่มือ ที่จูนไว้แล้ว" Style="{StaticResource CardSub}"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="330"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <Button x:Name="CycleBtn" Style="{StaticResource KeyBtn}" FontSize="11" Padding="9,2" MinWidth="0"
                                                            DockPanel.Dock="Right" VerticalAlignment="Center" Click="Cycle_Click"
                                                            ToolTip="ปุ่มในเกม (ตอนเปิดมาโคร): กดเปล่า = วนปืน · Ctrl/Alt = base ±0.5 · Shift+Ctrl/Alt = ซ้าย/ขวา ±0.5"/>
                                                    <TextBlock Text="&#xE8B3;" Style="{StaticResource Glyph}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="ชุดค่าสโคป" Style="{StaticResource CardTitle}"/>
                                                        <TextBlock Text="คลิก = เลือกชุดที่จะปรับ · ดับเบิลคลิก = เปลี่ยนชื่อ" Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <UniformGrid x:Name="GunGrid" Columns="3" Margin="-5,0,-5,0"
                                                             ToolTip="คลิก = เลือกปืนที่จะปรับค่า · ดับเบิลคลิก = เปลี่ยนชื่อ"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="ในเกม: Ctrl/Alt + Back" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                                                               DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xE9E9;" Style="{StaticResource Glyph}"/>
                                                    <TextBlock x:Name="TuneTitle" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="82"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="62"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="แรงดึงลง" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Style="{StaticResource StepBtn}" Content="&#xE738;" Tag="base-" Click="Step_Click"/>
                                                    <Slider x:Name="BaseSlider" Grid.Column="2" Style="{StaticResource NiceSlider}" Minimum="0" Maximum="50" Margin="8,0"/>
                                                    <Button Grid.Column="3" Style="{StaticResource StepBtn}" Content="&#xE710;" Tag="base+" Click="Step_Click"/>
                                                    <TextBlock x:Name="BaseValue" Grid.Column="4" FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                                               Foreground="#8FDBFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="82"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="62"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="ซ้าย / ขวา" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Style="{StaticResource StepBtn}" Content="&#xE738;" Tag="x-" Click="Step_Click"/>
                                                    <Grid Grid.Column="2" Margin="8,0" SizeChanged="XBar_SizeChanged">
                                                        <Border Height="5" CornerRadius="2.5" Background="#1A2440" Margin="8,0" VerticalAlignment="Center"/>
                                                        <Border x:Name="XFill" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                                                        <Border x:Name="XMid" Width="2" Height="11" CornerRadius="1" Background="#5A6C94"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                        <Slider x:Name="XSlider" Style="{StaticResource CenterSlider}" Minimum="-5" Maximum="5"/>
                                                    </Grid>
                                                    <Button Grid.Column="3" Style="{StaticResource StepBtn}" Content="&#xE710;" Tag="x+" Click="Step_Click"/>
                                                    <TextBlock x:Name="XValue" Grid.Column="4" FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                                               Foreground="#8FDBFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <DockPanel Margin="0,12,0,0">
                                                    <Button x:Name="CalibBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="8,0,0,0"
                                                            Click="Calib_Click" ToolTip="อัดการลากเมาส์ของคุณตอนยิงจริง แล้วตั้ง base / x / กราฟให้อัตโนมัติ">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="อัดค่า" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="ShotsBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="8,0,0,0"
                                                            Click="Shots_Click" ToolTip="ตารางแรงดึงรายนัด: นัดที่ 1–42 ดึงลงเท่าไหร่ · ความเร็วยิง · จำนวนนัด · ปรับทีละช่วง">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="รายนัด" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="SegsBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="8,0,0,0"
                                                            Click="Segs_Click" ToolTip="แก้กราฟแรงดีดตามเวลา (ตาราง segs) ของแต่ละปืน">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="กราฟ" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="ApplyBtn" Style="{StaticResource KeyBtn}" HorizontalAlignment="Stretch"
                                                            Click="Apply_Click" ToolTip="ใช้ค่านี้ทันที (ปล่อยหลอดเลื่อนแล้วจะใช้ให้เอง)"/>
                                                </DockPanel>
                                                <Button x:Name="EyeBtn" Style="{StaticResource KeyBtn}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                        BorderBrush="#C9A54A" Click="Eye_Click" Visibility="Collapsed"
                                                        ToolTip="ยิงใส่กำแพง มือนิ่ง ดูรอยกระสุน แล้วตอบด้วยปุ่มลูกศร — ป้ายบนจอบอกทุกขั้น"/>
                                                <Button x:Name="VisionBtn" Style="{StaticResource KeyBtn}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                        BorderBrush="#1D6BFF" Click="Vision_Click" Visibility="Collapsed"
                                                        ToolTip="สแกนหน้ากระเป๋า (Tab) ตรวจจับปืน ของแต่ง ลำกล้อง และคำนวณแรงดีดออโต้">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#5CE1FF"/>
                                                        <TextBlock Text="AI Detect ปืน · ของแต่ง · ลำกล้อง (Tab)" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- โปรไฟล์ค่าปืน: เก็บหลายชุด / ส่งออก / นำเข้า -->
                                        <Border Style="{StaticResource Card}" Padding="16,10,12,10">
                                            <DockPanel>
                                                <Button x:Name="PresetMoreBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="8,0,0,0"
                                                        Content="นำเข้า / ส่งออก" Click="PresetMore_Click" ToolTip="นำเข้าจากไฟล์ · ส่งออกเป็นไฟล์ · ลบ · เปิดโฟลเดอร์"/>
                                                <Button x:Name="PresetSaveBtn" DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Margin="8,0,0,0"
                                                        Content="บันทึก" Click="PresetSave_Click" ToolTip="บันทึกค่าปืนทั้ง 3 ชุดตอนนี้เป็นโปรไฟล์"/>
                                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                           VerticalAlignment="Center" Width="24"/>
                                                <Button x:Name="PresetBtn" Style="{StaticResource KeyBtn}" HorizontalContentAlignment="Left"
                                                        Click="Preset_Click" ToolTip="เลือกโปรไฟล์ค่าปืนที่บันทึกไว้"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <!-- การยิง: โหมดดึง + หยุดหลังยิงครบ -->
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="&#xE7C8;" Style="{StaticResource Glyph}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="การยิง" Style="{StaticResource CardTitle}"/>
                                                        <TextBlock Text="ดึงตอนไหน · หยุดดึงเมื่อแม็กหมด" Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <Grid Margin="0,12,0,0" ToolTip="ยิงทุกครั้ง = ดึงทั้งยิงสะโพกและเล็ง · คลิกขวาค้าง = ดึงเฉพาะตอนกดคลิกขวาค้างไว้ (เล็ง ADS)">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="ดึงตอน" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                    <RadioButton x:Name="AdsAllRb" Grid.Column="1" GroupName="ads" Style="{StaticResource SegRadio}" Checked="AdsRb_Checked">
