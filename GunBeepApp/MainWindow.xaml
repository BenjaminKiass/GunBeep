                                                    <StackPanel>
                                                        <TextBlock Text="คำนวณแรงดีด" Style="{StaticResource CardTitle}"/>
                                                        <TextBlock Text="ชุดค่า × ปืน × สโคป × ของแต่ง × ย่อ/หมอบ" Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}"/>
