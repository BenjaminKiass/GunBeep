                                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Width="26"/>
                                                    <TextBlock Text="เปิดมาโครเองตอนเข้าเกม" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Border Height="1" Background="{StaticResource LineBrush}"/>
