                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="แม็กหมด" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                    <RadioButton x:Name="MagOnRb" Grid.Column="1" GroupName="mag" Style="{StaticResource SegRadio}" Checked="MagRb_Checked">
                                                        <TextBlock Text="นับกระสุน" VerticalAlignment="Center"/>
                                                    </RadioButton>
