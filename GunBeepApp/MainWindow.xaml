                                <Border Style="{StaticResource Card}" Padding="20,18">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" VerticalAlignment="Center" BorderBrush="#1D6BFF"
                                                    Click="Loot_Click" ToolTip="ลากจุดบนภาพหน้ากระเป๋าให้ตรงช่องของบนพื้น">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="ตั้งตำแหน่ง" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="22" Foreground="#C9A54A"/>
                                            <StackPanel>
                                                <TextBlock Text="เก็บของเร็ว (Auto-pickup)" FontSize="17" FontWeight="Black" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="ลากของบนพื้นเข้ากระเป๋าให้ทีละช่อง จากล่างขึ้นบน — ทำเฉพาะตอนเปิดกระเป๋าในเกม" Style="{StaticResource CardSub}"/>
