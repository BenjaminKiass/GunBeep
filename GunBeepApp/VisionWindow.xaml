<Window x:Class="GunBeep.VisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Weapon &amp; Attachment Detector" Width="920" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Leelawadee UI" UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8094BC"/>
        <SolidColorBrush x:Key="LineBrush" Color="#18223A"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#0B1222"/>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#121B30"/>
            <Setter Property="BorderBrush" Value="#24345A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" MinWidth="60" Height="30" CornerRadius="8" Padding="12,0"
                                Background="#121B30" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" BlurRadius="12" ShadowDepth="0" Color="#1D6BFF" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A2C52"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#1D6BFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" CornerRadius="12" Background="#18223A" BorderBrush="#24345A" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="18" Height="18" Fill="#6E82A8" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1D6BFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#5CE1FF"/>
                                <Setter TargetName="thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="#070B16" BorderBrush="#1D6BFF" BorderThickness="1.5" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Color="#000" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Title_Drag">
                <Button DockPanel.Dock="Right" Style="{StaticResource ChromeBtn}" Content="&#xE8BB;" Click="Close_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1D6BFF" Offset="0"/>
                                <GradientStop Color="#5CE1FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AI Detect อาวุธ · ของแต่ง · ลำกล้อง" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="สแกนหน้ากระเป๋า (Tab) ใน PUBG และคำนวณแรงดีดออโต้" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Content Area (2 Columns) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Detection Results -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <!-- Slot 1 Card -->
                    <Border CornerRadius="14" Background="#0D1322" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right" CornerRadius="6" Background="#1D6BFF" Padding="8,2">
                                    <TextBlock x:Name="S1RecoilBadge" Text="Base - · X -" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="ช่อง 1 (อาวุธหลัก)" FontSize="13.5" FontWeight="Bold" Foreground="#8FDBFF"/>
                            </DockPanel>

                            <!-- Icons Row -->
                            <UniformGrid Columns="5" Margin="0,4,0,8">
                                <!-- Weapon -->
                                <Border CornerRadius="8" Background="#121B30" BorderBrush="#24345A" BorderThickness="1" Margin="3" Padding="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="S1ImgWeapon" Width="48" Height="48" Stretch="Uniform"/>
                                        <TextBlock x:Name="S1TxtWeapon" Text="รอสแกน" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Scope -->
                                <Border CornerRadius="8" Background="#121B30" BorderBrush="#24345A" BorderThickness="1" Margin="3" Padding="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="S1ImgScope" Width="48" Height="48" Stretch="Uniform"/>
                                        <TextBlock x:Name="S1TxtScope" Text="-" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Muzzle -->
                                <Border CornerRadius="8" Background="#121B30" BorderBrush="#24345A" BorderThickness="1" Margin="3" Padding="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="S1ImgMuzzle" Width="48" Height="48" Stretch="Uniform"/>
                                        <TextBlock x:Name="S1TxtMuzzle" Text="-" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Grip -->
                                <Border CornerRadius="8" Background="#121B30" BorderBrush="#24345A" BorderThickness="1" Margin="3" Padding="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="S1ImgGrip" Width="48" Height="48" Stretch="Uniform"/>
                                        <TextBlock x:Name="S1TxtGrip" Text="-" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Stock -->
                                <Border CornerRadius="8" Background="#121B30" BorderBrush="#24345A" BorderThickness="1" Margin="3" Padding="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="S1ImgStock" Width="48" Height="48" Stretch="Uniform"/>
                                        <TextBlock x:Name="S1TxtStock" Text="-" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Content="ใช้ค่านี้กับปืน 1" Click="ApplySlot1_Click"/>
                                <TextBlock x:Name="S1Formula" Text="กดปุ่ม [สแกนหน้าจอนี้] เพื่อตรวจจับ"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Slot 2 Card -->
                    <Border CornerRadius="14" Background="#0D1322" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right" CornerRadius="6" Background="#1D6BFF" Padding="8,2">
                                    <TextBlock x:Name="S2RecoilBadge" Text="Base - · X -" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="ช่อง 2 (อาวุธรอง)" FontSize="13.5" FontWeight="Bold" Foreground="#8FDBFF"/>
                            </DockPanel>

                            <!-- Icons Row -->
                            <UniformGrid Columns="5" Margin="0,4,0,8">
                                <!-- Weapon -->
                                <Border CornerRadius="8" Background="#121B30" BorderBrush="#24345A" BorderThickness="1" Margin="3" Padding="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="S2ImgWeapon" Width="48" Height="48" Stretch="Uniform"/>
                                        <TextBlock x:Name="S2TxtWeapon" Text="รอสแกน" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Scope -->
                                <Border CornerRadius="8" Background="#121B30" BorderBrush="#24345A" BorderThickness="1" Margin="3" Padding="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="S2ImgScope" Width="48" Height="48" Stretch="Uniform"/>
                                        <TextBlock x:Name="S2TxtScope" Text="-" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Muzzle -->
                                <Border CornerRadius="8" Background="#121B30" BorderBrush="#24345A" BorderThickness="1" Margin="3" Padding="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="S2ImgMuzzle" Width="48" Height="48" Stretch="Uniform"/>
                                        <TextBlock x:Name="S2TxtMuzzle" Text="-" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Grip -->
                                <Border CornerRadius="8" Background="#121B30" BorderBrush="#24345A" BorderThickness="1" Margin="3" Padding="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="S2ImgGrip" Width="48" Height="48" Stretch="Uniform"/>
                                        <TextBlock x:Name="S2TxtGrip" Text="-" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Stock -->
                                <Border CornerRadius="8" Background="#121B30" BorderBrush="#24345A" BorderThickness="1" Margin="3" Padding="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="S2ImgStock" Width="48" Height="48" Stretch="Uniform"/>
                                        <TextBlock x:Name="S2TxtStock" Text="-" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource KeyBtn}" Content="ใช้ค่านี้กับปืน 2" Click="ApplySlot2_Click"/>
                                <TextBlock x:Name="S2Formula" Text="กดปุ่ม [สแกนหน้าจอนี้] เพื่อตรวจจับ"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Scan Button -->
                    <Button x:Name="ScanNowBtn" Style="{StaticResource KeyBtn}" Height="40" Background="#1D6BFF" BorderBrush="#5CE1FF"
                            Click="ScanNow_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="สแกนหน้าจอตอนนี้" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatusMsg" Text="พร้อมสแกน (เปิดหน้ากระเป๋า Tab ในเกม แล้วกดสแกน)" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Right Column: Alignment & Template Learner -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <!-- Resolution & Offsets -->
                    <Border CornerRadius="14" Background="#0D1322" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ความละเอียด &amp; ปรับตำแหน่งกรอบ" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Button x:Name="Res1728Btn" Style="{StaticResource KeyBtn}" Content="1728×1080 (จอยืด)" Margin="0,0,4,0" Click="Res1728_Click"/>
                                <Button x:Name="Res1920Btn" Style="{StaticResource KeyBtn}" Content="1920×1080" Margin="4,0,0,0" Click="Res1920_Click"/>
                            </UniformGrid>

                            <!-- Offset X -->
                            <DockPanel Margin="0,4,0,6">
                                <TextBlock x:Name="TxtOffX" DockPanel.Dock="Right" Text="+0 px" Width="45" TextAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#8FDBFF"/>
                                <TextBlock Text="เลื่อน ซ้าย/ขวา:" FontSize="12" Foreground="{StaticResource MutedBrush}" Width="95"/>
                                <Slider x:Name="SliderOffX" Minimum="-120" Maximum="120" Value="0" ValueChanged="Offset_Changed"/>
                            </DockPanel>

                            <!-- Offset Y -->
                            <DockPanel Margin="0,4,0,6">
                                <TextBlock x:Name="TxtOffY" DockPanel.Dock="Right" Text="+0 px" Width="45" TextAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#8FDBFF"/>
                                <TextBlock Text="เลื่อน บน/ล่าง:" FontSize="12" Foreground="{StaticResource MutedBrush}" Width="95"/>
                                <Slider x:Name="SliderOffY" Minimum="-120" Maximum="120" Value="0" ValueChanged="Offset_Changed"/>
                            </DockPanel>

                            <Button Style="{StaticResource KeyBtn}" Content="รีเซ็ตตำแหน่งเป็น 0" HorizontalAlignment="Right" Margin="0,4,0,0" Click="ResetOffset_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Template Learner -->
                    <Border CornerRadius="14" Background="#0D1322" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📷 บันทึกแม่แบบจากจอสด (Learner)" FontSize="13.5" FontWeight="Bold" Foreground="#C9A54A" Margin="0,0,0,6"/>
                            <TextBlock Text="กดสแกนแล้วเลือกบันทึกไอเทมที่ถืออยู่เป็นแม่แบบส่วนตัวได้ทันที:"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LearnSlotCmb" Grid.Column="0" Margin="0,0,4,0" SelectedIndex="0">
                                    <ComboBoxItem Content="ช่อง 1"/>
                                    <ComboBoxItem Content="ช่อง 2"/>
                                </ComboBox>
                                <ComboBox x:Name="LearnCatCmb" Grid.Column="1" Margin="4,0,0,0" SelectedIndex="0" SelectionChanged="LearnCat_Changed">
                                    <ComboBoxItem Content="Weapon (ปืน)"/>
                                    <ComboBoxItem Content="Muzzle (ปลอก)"/>
                                    <ComboBoxItem Content="Grip (ด้ามจับ)"/>
                                    <ComboBoxItem Content="Stock (พานท้าย)"/>
                                    <ComboBoxItem Content="Scope (กล้อง)"/>
                                </ComboBox>
                            </Grid>

                            <ComboBox x:Name="LearnItemCmb" IsEditable="True" Margin="0,0,0,8"/>

                            <Button x:Name="SaveTemplateBtn" Style="{StaticResource KeyBtn}" Content="บันทึกภาพนี้เป็นแม่แบบ"
                                    BorderBrush="#C9A54A" Click="SaveTemplate_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Settings switches -->
                    <Border CornerRadius="14" Background="#0D1322" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <ToggleButton x:Name="AutoTabSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Settings_Changed"/>
                                <TextBlock Text="สแกนอัตโนมัติเมื่อกด Tab" FontSize="12.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,4"/>
                            <DockPanel Margin="0,4,0,0">
                                <ToggleButton x:Name="AutoApplySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Settings_Changed"/>
                                <TextBlock Text="ส่งค่าเข้า G Hub ทันทีเมื่อสแกนพบ" FontSize="12.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
